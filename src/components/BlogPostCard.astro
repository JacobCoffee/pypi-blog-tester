---
import { formatDate, postUrl, withBase, renderDescriptionLinks } from "../lib/utils";
import type { ResolvedAuthor } from "../lib/authors";

interface Props {
  slug: string;
  title: string;
  publishDate: string;
  authors: readonly ResolvedAuthor[];
  description?: string | null;
  tags?: readonly string[];
}

const { slug, title, publishDate, authors, description, tags } = Astro.props;
---

<article class="post-card group relative px-5 py-4">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <a href={withBase(postUrl(slug))} class="block">
        <h3 class="text-base font-semibold leading-snug text-zinc-900 transition-colors group-hover:text-[#306998] dark:text-zinc-100 dark:group-hover:text-[#5a9fd4]" style="font-family: var(--font-display);">
          {title}
        </h3>
      </a>
      <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-zinc-500 dark:text-zinc-400">
        <span class="flex flex-wrap items-center gap-x-1">
          {authors.map((a, i) => (
            <>
              {i > 0 && <span class="text-zinc-400 dark:text-zinc-500">&amp;</span>}
              <a href={withBase(`/author/${a.id}`)} class="font-medium text-zinc-600 hover:text-[#306998] dark:text-zinc-300 dark:hover:text-[#5a9fd4] transition-colors">{a.name}</a>
            </>
          ))}
        </span>
        <span class="text-zinc-300 dark:text-zinc-600">&middot;</span>
        <time datetime={publishDate}>{formatDate(publishDate)}</time>
      </div>
      {description && (
        <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400" set:html={renderDescriptionLinks(description)} />
      )}
      {tags && tags.length > 0 && (
        <div class="mt-2.5 flex flex-wrap gap-1.5">
          {tags.slice(0, 4).map((tag) => (
            <a
              href={withBase(`/tags/${tag}`)}
              class="tag-pill rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
    </div>

  </div>
</article>
