---
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { getCollection, render } from "astro:content";
import { resolveAuthors } from "../../lib/authors";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((p) => p.data.published)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const references = (remarkPluginFrontmatter?.references ?? []) as Array<{ type: string; label: string; url: string }>;
const authors = await resolveAuthors(post.data.authors);

const allPosts = await getCollection("posts");
const related = post.data.related
  .map((slug) => allPosts.find((p) => p.id === slug))
  .filter((p): p is (typeof allPosts)[number] => p !== undefined && p.data.published);
---

<BlogPostLayout
  title={post.data.title}
  publishDate={post.data.publishDate.toISOString()}
  updatedDate={post.data.updatedDate?.toISOString()}
  authors={authors}
  description={post.data.description}
  tags={post.data.tags}
  slug={post.id}
  fediverseCreator={post.data.fediverseCreator}
  references={references}
  related={related}
>
  <Content />
</BlogPostLayout>
